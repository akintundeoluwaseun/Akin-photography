# Copy to .env (or set these in your host's dashboard). Never commit real values.
PORT=3000
NODE_ENV=production
# Public address of the site (used for sitemap, canonical links and social previews)
SITE_URL=https://www.your-domain.com
# Admin sign-in (phone number + password hash) lives in lib/admin-account.js, not here.
# Saving changes on Vercel: a GitHub token that can read/write this repo's contents.
GITHUB_TOKEN=
# Optional. Defaults to the repo Vercel deployed from.
GITHUB_REPO=
# Optional. Any long random text; encrypts the saved database. Defaults to a key derived from the token.
DATA_KEY=
# Where the database and uploaded photographs live. Point this at a persistent disk.
DATA_DIR=./data

# Push alerts and footer credit (optional)
SITE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CREDIT_URL=
