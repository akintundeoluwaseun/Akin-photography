{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,seed,node_modules/better-sqlite3,node_modules/@img,node_modules/sharp}/**",
      "maxDuration": 30
    },
    "api/health.js": {
      "includeFiles": "{public,seed,node_modules/better-sqlite3,node_modules/@img,node_modules/sharp}/**",
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/health$).*)",
      "destination": "/api/index"
    }
  ]
}
